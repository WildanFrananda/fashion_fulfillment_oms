<div class="navbar">
  <div class="brand-title">
    <span>🏬 Fashion Fulfillment OMS</span>
    <span class="brand-badge"><%= @current_merchant ? @current_merchant.name : "Select Merchant" %></span>
  </div>

  <div style="display: flex; align-items: center; gap: 20px;">
    <div class="live-status">
      <div class="pulse-dot"></div>
      <span>Action Cable Stream Active</span>
    </div>

    <%= form_with url: request.path, method: :get, local: true, style: "display: inline-block;" do |f| %>
      <%= f.select :merchant_id, 
            options_from_collection_for_select(@merchants || [], :id, :name, @current_merchant&.id), 
            {}, 
            class: "merchant-select", 
            onchange: "this.form.submit()" %>
    <% end %>
  </div>
</div>
