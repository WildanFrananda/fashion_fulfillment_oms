  <%= link_to "⚡ FleetPulse Driver Radar", fleet_radar_path(merchant_id: @current_merchant&.id), class: "step-pill #{'active' if current_page?(fleet_radar_path)}" %>
  <%= link_to "🔄 Returns & Exchange Hub", returns_dashboard_path(merchant_id: @current_merchant&.id), class: "step-pill #{'active' if current_page?(returns_dashboard_path)}" %>
