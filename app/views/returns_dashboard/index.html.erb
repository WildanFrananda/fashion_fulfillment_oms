<%= render "shared/navbar" %>
<%= render "shared/navigation_tabs" %>

<% if flash[:notice].present? %>
  <div class="flash-banner flash-notice">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div class="flash-banner flash-alert">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<h2 style="margin-bottom: 20px; font-size: 22px; font-weight: 600;">📋 Customer Return & Exchange Claims</h2>

<div class="grid-container">
  <% if (@return_items || []).empty? %>
    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-muted);">
      No return claims submitted for this merchant.
    </div>
  <% else %>
    <% (@return_items || []).each do |ret| %>
      <div class="order-card" style="border-color: rgba(239, 68, 68, 0.4);">
        <div>
          <div class="card-header">
            <span class="order-num">🔄 Return #RET-<%= ret.id %></span>
            <span class="status-badge status-<%= ret.status %>"><%= ret.status.tr('_', ' ') %></span>
          </div>

          <div style="font-size: 13px; color: var(--text-main); margin-bottom: 6px;">
            📦 Associated Order: <strong>#<%= ret.order ? ret.order.order_number : '-' %></strong>
          </div>

          <div style="font-size: 13px; color: var(--text-muted); margin-bottom: 6px;">
            👤 Customer: <strong><%= ret.order ? ret.order.buyer_name : '-' %></strong> (📞 <%= ret.order ? ret.order.buyer_phone : '-' %>)
          </div>

          <!-- Reason & QA Notes Box -->
          <div class="item-list" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);">
            <div style="font-size: 11px; font-weight: bold; color: #f87171; margin-bottom: 4px; text-transform: uppercase;">
              CUSTOMER RETURN REASON:
            </div>
            <div style="font-size: 13px; color: #fecdd3;">
              "<%= ret.reason %>"
            </div>
          </div>
        </div>

        <!-- Returns State Machine Action Buttons -->
        <div class="actions-group">
          <% if ret.status == 'requested' %>
            <%= button_to "🚚 Mark Picked Up from Buyer", update_status_returns_dashboard_path(ret.id, merchant_id: @current_merchant&.id, status: 'picked_up_from_buyer'), 
                  method: :post, 
                  class: "btn-action btn-fleetpulse" %>
          <% elsif ret.status == 'picked_up_from_buyer' %>
            <%= button_to "🏬 Receive at Warehouse", update_status_returns_dashboard_path(ret.id, merchant_id: @current_merchant&.id, status: 'received_at_warehouse'), 
                  method: :post, 
                  class: "btn-action" %>
          <% elsif ret.status == 'received_at_warehouse' %>
            <%= button_to "🔍 Pass QA & Inspect", update_status_returns_dashboard_path(ret.id, merchant_id: @current_merchant&.id, status: 'inspected'), 
                  method: :post, 
                  class: "btn-action btn-success" %>
          <% elsif ret.status == 'inspected' %>
            <%= button_to "✅ Resolve & Issue Exchange", update_status_returns_dashboard_path(ret.id, merchant_id: @current_merchant&.id, status: 'resolved'), 
                  method: :post, 
                  class: "btn-action btn-success" %>
          <% else %>
            <div style="text-align: center; font-size: 13px; color: #34d399; font-weight: bold; padding: 8px;">
              ✅ Return Resolved on <%= ret.resolved_at ? ret.resolved_at.strftime("%d %b %Y %H:%M") : 'Today' %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
