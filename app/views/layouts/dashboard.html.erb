<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LUXE OMS - Fashion Fulfillment Control Center</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "dashboard", media: "all" %>
  <style>
    body {
      display: flex;
      padding: 0;
      background: var(--bg-dark);
    }
    .app-sidebar {
      width: 260px;
      min-width: 260px;
      height: 100vh;
      position: sticky;
      top: 0;
      background: var(--surface-container-lowest);
      border-right: 1px solid var(--border-highlight);
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow-y: auto;
    }
    .main-viewport {
      flex: 1;
      padding: 32px 40px;
      max-width: 1600px;
      min-height: 100vh;
      overflow-y: auto;
    }
    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin: 20px 0;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 10px;
      color: var(--on-surface-variant);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .nav-item:hover {
      background: var(--surface-container-high);
      color: var(--on-surface);
    }
    .nav-item.active {
      background: var(--primary-neon);
      color: var(--on-primary);
      box-shadow: 0 4px 14px var(--primary-glow);
    }
    .btn-emergency {
      width: 100%;
      background: rgba(147, 0, 10, 0.2);
      border: 1px solid var(--error-container);
      color: var(--error-rose);
      padding: 10px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-emergency:hover {
      background: var(--error-container);
      color: #fff;
    }
  </style>
</head>
<body>

  <!-- Left Sidebar Navigation Layout matching Stitch AI screen.png -->
  <aside class="app-sidebar">
    <div>
      <!-- Brand Logo Header -->
      <div style="margin-bottom: 20px;">
        <h1 style="font-size: 24px; font-weight: 800; color: #fff; font-family: 'Outfit'; letter-spacing: -0.5px;">LUXE OMS</h1>
        <div class="live-status" style="margin-top: 4px;">
          <div class="pulse-dot"></div>
          <span style="font-size: 12px;">Stream Active</span>
        </div>
      </div>

      <!-- Merchant Switcher Container Card -->
      <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); padding: 12px; border-radius: 10px; margin-bottom: 20px;">
        <div style="font-size: 11px; color: var(--on-surface-variant); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">
          Merchant
        </div>
        <%= form_with url: request.path, method: :get, local: true do |f| %>
          <%= f.select :merchant_id, 
                options_from_collection_for_select(@merchants || [], :id, :name, @current_merchant&.id), 
                {}, 
                class: "merchant-select", 
                style: "width: 100%; background: transparent; border: none; font-weight: 700; font-size: 13px; color: #fff; padding: 0; cursor: pointer;",
                onchange: "this.form.submit()" %>
        <% end %>
      </div>

      <!-- Main Navigation Menu List -->
      <nav class="sidebar-nav">
        <%= link_to orders_path(merchant_id: @current_merchant&.id), class: "nav-item #{'active' if current_page?(orders_path)}" do %>
          <span>📦</span> <span>Order Queue</span>
        <% end %>

        <%= link_to fleet_radar_path(merchant_id: @current_merchant&.id), class: "nav-item #{'active' if current_page?(fleet_radar_path)}" do %>
          <span>🎯</span> <span>FleetPulse Radar</span>
        <% end %>

        <%= link_to returns_dashboard_path(merchant_id: @current_merchant&.id), class: "nav-item #{'active' if current_page?(returns_dashboard_path)}" do %>
          <span>↩️</span> <span>Returns Hub</span>
        <% end %>

        <%= link_to inventory_dashboard_path(merchant_id: @current_merchant&.id), class: "nav-item #{'active' if current_page?(inventory_dashboard_path)}" do %>
          <span>🏬</span> <span>Inventory</span>
        <% end %>

        <%= link_to analytics_dashboard_path(merchant_id: @current_merchant&.id), class: "nav-item #{'active' if current_page?(analytics_dashboard_path)}" do %>
          <span>📊</span> <span>Analytics</span>
        <% end %>

        <%= link_to manifests_dashboard_path(merchant_id: @current_merchant&.id), class: "nav-item #{'active' if current_page?(manifests_dashboard_path)}" do %>
          <span>📄</span> <span>Driver Manifests</span>
        <% end %>
      </nav>
    </div>

    <!-- Bottom Controls & Manager Profile -->
    <div>
      <div style="margin-bottom: 14px;">
        <%= button_to emergency_halt_orders_path(merchant_id: @current_merchant&.id), method: :post, class: "btn-emergency" do %>
          <span>⚠️ Emergency Halt</span>
        <% end %>
      </div>

      <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: var(--on-surface-variant); padding-left: 8px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <span>⚙️</span> <span>Settings</span>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <span>❓</span> <span>Support</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 10px; padding-top: 12px; border-top: 1px solid var(--border-highlight);">
        <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #8083ff, #a078ff); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px; color: #fff;">
          WM
        </div>
        <div>
          <div style="font-size: 13px; font-weight: 700; color: #fff;">Warehouse Manager</div>
          <div style="font-size: 11px; color: var(--on-surface-variant);">North Region Terminal</div>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main Viewport Area -->
  <main class="main-viewport">
    <%= yield %>
  </main>

</body>
</html>