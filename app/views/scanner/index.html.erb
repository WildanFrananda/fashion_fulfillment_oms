<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LUXE OMS - Mobile Real WebRTC Barcode Scanner</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "dashboard", media: "all" %>
  <style>
    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: #060e20;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .pda-container {
      width: 440px;
      max-width: 95vw;
      background: rgba(23, 31, 51, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 24px;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
      box-sizing: border-box;
    }
    .target-card {
      background: var(--surface-container);
      border: 1px solid var(--border-highlight);
      border-left: 4px solid var(--primary-neon);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .reticle-box {
      width: 100%;
      height: 230px;
      border-radius: 16px;
      background: #000;
      border: 1px solid var(--border-highlight);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      margin-bottom: 20px;
      overflow: hidden;
    }
    #camera-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .reticle-frame {
      width: 200px;
      height: 110px;
      border: 2px dashed rgba(78, 222, 163, 0.8);
      border-radius: 12px;
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 24px rgba(78, 222, 163, 0.4);
      pointer-events: none;
    }
    .reticle-frame::before {
      content: '';
      position: absolute;
      width: 100%;
      height: 2px;
      background: var(--secondary-emerald);
      box-shadow: 0 0 10px var(--secondary-emerald);
      animation: scanLaser 1.8s infinite ease-in-out;
    }
    @keyframes scanLaser {
      0% { top: 5%; }
      50% { top: 95%; }
      100% { top: 5%; }
    }
    .form-input, .select-input {
      width: 100%;
      background: var(--surface-container-low);
      border: 1px solid var(--border-highlight);
      border-radius: 12px;
      padding: 12px 14px;
      color: #fff;
      font-size: 13px;
      font-family: var(--font-tech);
      box-sizing: border-box;
      transition: border-color 0.2s ease;
    }
    .form-input:focus, .select-input:focus {
      outline: none;
      border-color: var(--primary-neon);
      box-shadow: 0 0 12px var(--primary-glow);
    }
  </style>
</head>
<body>

  <div class="pda-container">
    
    <!-- Top Header Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 22px;">📱</span>
        <div>
          <h1 style="font-size: 20px; font-weight: 800; color: #fff; font-family: 'Outfit'; margin: 0; letter-spacing: -0.5px;">
            LUXE OMS
          </h1>
          <div style="font-size: 11px; color: var(--on-surface-variant); font-family: var(--font-tech); margin-top: 2px;">
            <%= @current_merchant&.name %>
          </div>
        </div>
      </div>

      <button type="button" id="beep-btn" style="background: rgba(16, 185, 129, 0.12); border: 1px solid var(--secondary-emerald); color: var(--secondary-emerald); padding: 6px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; font-family: var(--font-tech); cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="toggleBeep();">
        <span>🔊</span> <span id="beep-status">Auto-Beep</span>
      </button>
    </div>

    <!-- Active Scan Target Card -->
    <% if @active_scan_target %>
      <div class="target-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <div style="font-family: var(--font-tech); font-size: 18px; font-weight: 700; color: #fff;">
            <%= @active_scan_target.order_number %>
          </div>

          <% 
            diff_min = (((@active_scan_target.same_day_cutoff_at - Time.current) / 60).round)
          %>
          <div style="background: rgba(255, 180, 171, 0.1); border: 1px solid var(--error-rose); color: var(--error-rose); padding: 4px 10px; border-radius: 8px; font-size: 11px; font-family: var(--font-tech); font-weight: 700;">
            ⏰ Due in <%= diff_min %>m
          </div>
        </div>

        <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 10px; padding: 12px 14px; margin-bottom: 12px;">
          <div style="font-size: 10px; font-family: var(--font-tech); color: var(--on-surface-variant); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">
            📍 TARGET RACK BIN
          </div>
          <div style="font-family: var(--font-tech); font-size: 20px; font-weight: 700; color: var(--secondary-emerald);">
            📍 <%= @active_scan_target.bin_location %>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div style="font-size: 15px; font-weight: 700; color: #fff; font-family: 'Outfit';">
              <%= @active_scan_target.product_name %>
            </div>
            <div style="font-size: 12px; font-family: var(--font-tech); color: var(--on-surface-variant); margin-top: 2px;">
              SKU: <span style="color: var(--primary-neon);"><%= @active_scan_target.sku %></span>
            </div>
          </div>
          <div style="background: var(--surface-container-high); border: 1px solid var(--border-highlight); border-radius: 8px; padding: 4px 10px; font-family: var(--font-tech); font-size: 12px; color: #fff; font-weight: 700;">
            1 / <%= @active_scan_target.total_items_count %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="target-card" style="border-left-color: var(--on-surface-variant); text-align: center; padding: 28px 16px;">
        <div style="font-size: 24px; margin-bottom: 8px;">📦</div>
        <div style="font-size: 15px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin-bottom: 6px;">
          NO ORDER SELECTED FOR SCANNING
        </div>
        <div style="font-size: 12px; color: var(--on-surface-variant); line-height: 1.5; margin-bottom: 16px;">
          Please select an order from the Order Queue to start barcode picking & packing.
        </div>
        <%= link_to orders_path(merchant_id: @current_merchant&.id), class: "btn-action", style: "background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; width: auto; padding: 8px 18px; font-size: 12px;" do %>
          <span>← Select Order in Order Queue</span>
        <% end %>
      </div>
    <% end %>

    <!-- Camera Device Selector Dropdown -->
    <div style="margin-bottom: 12px;">
      <select id="camera-select" class="select-input" onchange="switchCameraDevice(this.value)">
        <option value="">📷 Detecting Available Camera Devices...</option>
      </select>
    </div>

    <!-- WebRTC Live Camera Stream & Reticle Area -->
    <div class="reticle-box">
      <video id="camera-video" playsinline autoplay muted></video>
      <div class="reticle-frame">
        <span style="font-size: 10px; font-family: var(--font-tech); color: rgba(255,255,255,0.8); background: rgba(0,0,0,0.6); padding: 2px 6px; border-radius: 4px;">ALIGN BARCODE HERE</span>
      </div>
    </div>

    <!-- Live Flash Feedback Banner -->
    <% if flash[:notice].present? %>
      <div class="flash-banner flash-notice" style="margin-bottom: 16px; border-radius: 12px;">
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="flash-banner flash-alert" style="margin-bottom: 16px; border-radius: 12px;">
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <!-- Barcode Form Input & Action Buttons -->
    <% if @active_scan_target %>
      <%= form_with url: verify_scan_path(merchant_id: @current_merchant&.id), method: :post, local: true, id: "scan-form" do |f| %>
        <input type="hidden" name="order_id" value="<%= @active_scan_target.id %>">

        <div style="margin-bottom: 16px;">
          <%= f.text_field :scanned_code, placeholder: "║█║ Scan SKU Barcode or Resi AWB...", autofocus: true, id: "barcode-input", class: "form-input" %>
        </div>

        <!-- Hidden Image File Input for Image Upload Scanning -->
        <input type="file" id="image-file-input" accept="image/*" style="display:none;" onchange="handleImageScan(this)">

        <div style="display: flex; gap: 8px; margin-bottom: 20px;">
          <button type="button" class="btn-action" style="flex: 1; background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; font-size: 12px;" onclick="initWebRTCCamera();">
            <span>📷</span> <span id="camera-btn-text">Start Camera</span>
          </button>
          <button type="button" class="btn-action" style="flex: 1; background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; font-size: 12px;" onclick="document.getElementById('image-file-input').click();">
            <span>📁</span> <span>Upload Image</span>
          </button>
          <%= f.submit "⚡ Verify", class: "btn-action", style: "flex: 1; background: linear-gradient(135deg, #8083ff, #6366f1); color: #fff; font-weight: 700; font-size: 12px; border: none;" %>
        </div>
      <% end %>
    <% end %>

    <!-- Bottom Link -->
    <div style="text-align: center; border-top: 1px solid var(--border-highlight); padding-top: 16px;">
      <%= link_to orders_path(merchant_id: @current_merchant&.id), style: "color: var(--on-surface-variant); text-decoration: none; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;" do %>
        <span>←</span> <span>Back to Order Queue</span>
      <% end %>
    </div>

  </div>

  <script>
    let beepEnabled = true;
    let cameraStream = null;

    function toggleBeep() {
      beepEnabled = !beepEnabled;
      document.getElementById('beep-status').innerText = beepEnabled ? "Auto-Beep" : "Muted";
    }

    // Web Audio API Audio Synthesizer (Authentic Beep Tones without MP3 files)
    function playAudioTone(freq, duration) {
      if (!beepEnabled) return;
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = freq > 500 ? 'sine' : 'sawtooth';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {
        console.log("AudioContext blocked or uninitialized", e);
      }
    }

    // Populate Available Webcams in Dropdown
    async function populateCameraDevices() {
      const selectEl = document.getElementById('camera-select');
      if (!selectEl) return;

      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const videoInputs = devices.filter(d => d.kind === 'videoinput');

        selectEl.innerHTML = '';
        if (videoInputs.length === 0) {
          selectEl.innerHTML = '<option value="">📷 Default System Webcam</option>';
          return;
        }

        videoInputs.forEach((dev, idx) => {
          const opt = document.createElement('option');
          opt.value = dev.deviceId;
          opt.innerText = "📷 " + (dev.label || `Camera Device ${idx + 1}`);
          selectEl.appendChild(opt);
        });
      } catch (e) {
        selectEl.innerHTML = '<option value="">📷 Default System Webcam</option>';
      }
    }

    // Switch camera device when selected from dropdown
    async function switchCameraDevice(deviceId) {
      if (!deviceId) return;
      if (cameraStream) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
      }
      initWebRTCCamera(deviceId);
    }

    // Direct Single-Attempt WebRTC Camera Initialization
    async function initWebRTCCamera(selectedDeviceId) {
      const videoEl = document.getElementById('camera-video');
      const btnText = document.getElementById('camera-btn-text');

      if (cameraStream && !selectedDeviceId) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
        if (videoEl) videoEl.srcObject = null;
        if (btnText) btnText.innerText = "Start Camera";
        return;
      }

      try {
        let constraints = { video: true };

        if (selectedDeviceId) {
          constraints = { video: { deviceId: { exact: selectedDeviceId } } };
        } else {
          const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
          constraints = isMobile 
            ? { video: { facingMode: { ideal: "environment" } } }
            : { video: true };
        }

        cameraStream = await navigator.mediaDevices.getUserMedia(constraints);

        if (videoEl && cameraStream) {
          videoEl.srcObject = cameraStream;
          videoEl.play();
        }
        if (btnText) btnText.innerText = "Stop Camera";
        await populateCameraDevices();
        startNativeBarcodeDetection(videoEl);
      } catch (err) {
        console.error("Camera initialization error:", err);
        alert("📷 WebRTC Camera Initialization Error: " + (err.message || err.name) + "\n\nAnda juga dapat menggunakan tombol 'Upload Image' di bawah untuk memindai foto barcode resi/SKU.");
      }
    }

    // File Upload Barcode Scanner Engine
    async function handleImageScan(fileInput) {
      if (!fileInput.files || fileInput.files.length === 0) return;
      const file = fileInput.files[0];

      const img = new Image();
      img.src = URL.createObjectURL(file);
      img.onload = async () => {
        if ('BarcodeDetector' in window) {
          try {
            const barcodeDetector = new BarcodeDetector({ formats: ['code_128', 'code_39', 'qr_code', 'ean_13', 'ean_8'] });
            const barcodes = await barcodeDetector.detect(img);
            if (barcodes.length > 0) {
              const val = barcodes[0].rawValue;
              const input = document.getElementById('barcode-input');
              if (input) {
                input.value = val;
                playAudioTone(880, 0.15);
                document.getElementById('scan-form').submit();
              }
              return;
            }
          } catch (e) { }
        }

        // If BarcodeDetector did not find a barcode or is unsupported, notify user
        alert("📷 Foto berhasil diunggah. Silakan klik '⚡ Verify' untuk memverifikasi barcode.");
      };
    }

    // Real HTML5 BarcodeDetector API Frame Loop
    async function startNativeBarcodeDetection(videoEl) {
      if (!('BarcodeDetector' in window)) {
        console.log("Native BarcodeDetector API not supported in this browser. Hardware input active.");
        return;
      }

      try {
        const barcodeDetector = new BarcodeDetector({ formats: ['code_128', 'code_39', 'qr_code', 'ean_13', 'ean_8'] });
        const scanFrame = async () => {
          if (!cameraStream || videoEl.paused || videoEl.ended) return;
          try {
            const barcodes = await barcodeDetector.detect(videoEl);
            if (barcodes.length > 0) {
              const scannedValue = barcodes[0].rawValue;
              const input = document.getElementById('barcode-input');
              if (input) {
                input.value = scannedValue;
                playAudioTone(880, 0.15); // Success Beep
                document.getElementById('scan-form').submit();
              }
            }
          } catch (e) {
            // Frame analysis loop
          }
          if (cameraStream) requestAnimationFrame(scanFrame);
        };
        requestAnimationFrame(scanFrame);
      } catch (e) {
        console.log("BarcodeDetector initialization failed", e);
      }
    }

    // Auto Play Beep on Flash Notice / Alert
    window.addEventListener('DOMContentLoaded', () => {
      populateCameraDevices();
      const notice = document.querySelector('.flash-banner.flash-notice');
      const alertMsg = document.querySelector('.flash-banner.flash-alert');
      if (notice) playAudioTone(880, 0.15); // 880Hz Success Beep
      if (alertMsg) playAudioTone(220, 0.3); // 220Hz Error Tone

      const input = document.getElementById('barcode-input');
      if (input) input.focus();
    });
  </script>
</body>
</html>
