<% if flash[:notice].present? %>
  <div class="flash-banner flash-notice">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div class="flash-banner flash-alert">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<!-- Top Header Row -->
<div style="margin-bottom: 24px;">
  <h1 style="font-size: 32px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
    Settings & Merchant Logistics Configuration
  </h1>
  <p style="font-size: 14px; color: var(--on-surface-variant); margin: 0;">
    Manage your API credentials, SLA cutoffs, and Webhook integrations for the enterprise logistics network.
  </p>
</div>

<!-- Navigation Tabs Row -->
<div style="display: flex; gap: 10px; margin-bottom: 32px; border-bottom: 1px solid var(--border-highlight); padding-bottom: 16px; flex-wrap: wrap;">
  <button type="button" class="filter-pill-opt active">
    <span>🔑 API Keys</span>
  </button>
  <button type="button" class="filter-pill-opt" onclick="alert('Viewing SLA Cutoff Configuration.');">
    <span>⏰ SLA Cutoff Rules</span>
  </button>
  <button type="button" class="filter-pill-opt" onclick="alert('Viewing FleetPulse Elixir Webhook Channels.');">
    <span>⚡ FleetPulse Webhooks</span>
  </button>
  <button type="button" class="filter-pill-opt" onclick="alert('Managing Warehouse Staff Users.');">
    <span>👥 Staff Users</span>
  </button>
</div>

<!-- Main Settings Grid (Left Column 2 Cards, Right Column 1 Card) -->
<div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px;">

  <!-- Left Column -->
  <div style="display: flex; flex-direction: column; gap: 24px;">

    <!-- Card 1: Merchant Production Key -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 20px;">🔑</span>
          <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0;">Merchant Production Key</h3>
        </div>
        <span style="background: rgba(16, 185, 129, 0.15); border: 1px solid var(--secondary-emerald); color: var(--secondary-emerald); padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; font-family: var(--font-tech);">
          ACTIVE
        </span>
      </div>

      <p style="font-size: 13px; color: var(--on-surface-variant); margin-bottom: 20px;">
        Use this key to authenticate REST API requests for merchant <strong style="color: #fff;"><%= @current_merchant&.name %></strong>. Keep it secure.
      </p>

      <div style="display: flex; gap: 10px; margin-bottom: 16px; align-items: center;">
        <div style="flex: 1; height: 44px; background: var(--surface-container-lowest); border: 1px solid var(--border-highlight); border-radius: 8px; padding: 0 16px; font-family: var(--font-tech); font-size: 14px; color: var(--primary-neon); letter-spacing: 2px; display: flex; align-items: center; box-sizing: border-box; overflow: hidden;">
          <span id="api-key-text" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= @current_merchant&.api_key %></span>
        </div>

        <button type="button" class="btn-action" style="height: 44px; width: auto; padding: 0 18px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; display: flex; align-items: center; justify-content: center; gap: 6px; box-sizing: border-box; font-size: 13px;" onclick="navigator.clipboard.writeText(document.getElementById('api-key-text').innerText); alert('📋 API Key copied to clipboard!');">
          <span>📋 Copy</span>
        </button>

        <%= button_to regenerate_api_key_settings_path(merchant_id: @current_merchant&.id), 
              method: :post, 
              form: { style: "margin: 0; padding: 0; display: inline-flex;" },
              class: "btn-action", 
              style: "height: 44px; width: 44px; padding: 0; background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; display: flex; align-items: center; justify-content: center; box-sizing: border-box; font-size: 14px;" do %>
          <span>🔄</span>
        <% end %>
      </div>


      <div style="font-size: 12px; color: var(--on-surface-variant); display: flex; align-items: center; gap: 6px;">
        <span>ℹ️</span> <span>Last rotated: <%= time_ago_in_words(@current_merchant&.updated_at || Time.current) %> ago</span>
      </div>
    </div>

    <!-- Card 2: Integration Endpoints -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 20px;">📡</span>
          <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0;">Integration Endpoints</h3>
        </div>

        <%= button_to test_ping_settings_path(merchant_id: @current_merchant&.id), method: :post, class: "btn-action", style: "width: auto; padding: 8px 16px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; font-size: 12px; display: flex; align-items: center; gap: 6px;" do %>
          <span>⚡ Test Ping Latency</span>
        <% end %>
      </div>

      <p style="font-size: 13px; color: var(--on-surface-variant); margin-bottom: 20px;">
        Configure your network egress to allow traffic to these regional endpoints.
      </p>

      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div style="background: var(--surface-container-lowest); border: 1px solid var(--border-highlight); border-radius: 8px; padding: 14px 16px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="font-size: 11px; font-family: var(--font-tech); font-weight: 700; color: var(--on-surface-variant);">REST API (v1)</span>
            <span style="font-size: 11px; color: var(--secondary-emerald); font-weight: 700;">🟢 Operational</span>
          </div>
          <div style="font-family: var(--font-tech); font-size: 13px; color: #fff;">
            <%= request.base_url %>/api/v1/orders
          </div>
        </div>

        <div style="background: var(--surface-container-lowest); border: 1px solid var(--border-highlight); border-radius: 8px; padding: 14px 16px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="font-size: 11px; font-family: var(--font-tech); font-weight: 700; color: var(--on-surface-variant);">FLEETPULSE WEBSOCKET</span>
            <span style="font-size: 11px; color: var(--secondary-emerald); font-weight: 700;">🟢 Operational</span>
          </div>
          <div style="font-family: var(--font-tech); font-size: 13px; color: #fff;">
            <%= request.base_url.sub(/^http/, 'ws') %>/cable
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Right Column Card: SLA Cutoff Rules -->
  <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
        <span style="font-size: 20px;">⏱️</span>
        <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0;">SLA Cutoff Rules</h3>
      </div>

      <%= form_with url: update_cutoff_settings_path(merchant_id: @current_merchant&.id), method: :patch, local: true do |f| %>
        <div style="margin-bottom: 24px;">
          <label style="font-size: 12px; font-weight: 700; color: var(--on-surface-variant); display: block; margin-bottom: 8px;">
            Same-Day Dispatch Cutoff
          </label>

          <div style="display: flex; align-items: center; gap: 12px; background: var(--surface-container-lowest); border: 1px solid var(--border-highlight); border-radius: 8px; padding: 12px 16px; margin-bottom: 8px;">
            <span style="font-size: 16px;">⏱️</span>
            <%= f.select :cutoff_hour, 
                  options_for_select((8..22).map { |h| ["#{sprintf('%02d', h)}:00 WIB", h] }, @current_merchant&.cutoff_hour), 
                  {}, 
                  class: "merchant-select", 
                  style: "flex: 1; background: transparent; border: none; font-family: var(--font-tech); font-weight: 700; font-size: 15px; color: #fff; cursor: pointer;" %>
          </div>

          <p style="font-size: 12px; color: var(--on-surface-variant); margin: 0;">
            Orders placed after this time roll over to the next business day.
          </p>

          <div style="margin-top: 14px;">
            <%= f.submit "Update Cutoff Hour", class: "btn-action btn-success", style: "width: 100%;" %>
          </div>
        </div>
      <% end %>

      <div style="padding-top: 20px; border-top: 1px solid var(--border-highlight); margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <div>
            <div style="font-size: 14px; font-weight: 700; color: #fff;">Auto-dispatch Triage</div>
            <div style="font-size: 12px; color: var(--on-surface-variant); margin-top: 2px;">
              Automatically assign fleet based on algorithmic routing.
            </div>
          </div>
          <input type="checkbox" checked style="width: 20px; height: 20px; accent-color: var(--primary-neon); cursor: pointer;">
        </div>
      </div>
    </div>

    <!-- Tip Note Box -->
    <div style="background: rgba(128, 131, 255, 0.1); border: 1px solid rgba(128, 131, 255, 0.25); border-radius: 12px; padding: 16px; display: flex; gap: 12px; align-items: flex-start;">
      <span style="font-size: 18px;">💡</span>
      <div style="font-size: 12px; color: var(--on-surface); line-height: 1.5;">
        Modifying cutoff times may affect your contracted merchant SLA guarantees. Proceed with caution.
      </div>
    </div>
  </div>

</div>
