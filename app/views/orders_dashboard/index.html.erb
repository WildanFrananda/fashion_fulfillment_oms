<div class="navbar">
  <div class="brand-title">
    <span>🏬 Fashion Fulfillment OMS</span>
    <span class="brand-badge"><%= @current_merchant ? @current_merchant.name : "Select Merchant" %></span>
  </div>

  <div style="display: flex; align-items: center; gap: 20px;">
    <div class="live-status">
      <div class="pulse-dot"></div>
      <span>Action Cable WebSocket Live Streaming Active</span>
    </div>

    <%= form_with url: "/orders", method: :get, local: true, style: "display: inline-block;" do |f| %>
      <%= f.select :merchant_id, 
            options_from_collection_for_select(@merchants || [], :id, :name, @current_merchant&.id), 
            {}, 
            class: "merchant-select", 
            onchange: "this.form.submit()" %>
    <% end %>
  </div>
</div>

<% if flash[:notice].present? %>
  <div class="flash-banner flash-notice">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div class="flash-banner flash-alert">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<h2 style="margin-bottom: 20px; font-size: 22px; font-weight: 600;">📦 Operational Order SLA Queue</h2>

<div class="grid-container" id="order-queue-grid">
  <% if @order_cards.empty? %>
    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-muted);">
      No orders in queue for this merchant.
    </div>
  <% else %>
    <% @order_cards.each do |card| %>
      <div class="order-card" id="order-card-<%= card.id %>">
        <div class="card-header">
          <span class="order-num">#<%= card.order_number %></span>
          <span class="urgency-badge urgency-<%= card.sla_urgency %>"><%= card.sla_urgency.tr('_', ' ') %></span>
        </div>

        <div style="font-size: 14px; color: var(--text-main); margin-bottom: 4px;">
          👤 <%= card.buyer_name %>
        </div>
        <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">
          📍 <%= card.shipping_address %>
        </div>

        <div class="item-list">
          <% card.items.each do |item| %>
            <div class="item-row">
              <span><%= item.quantity %>x <%= item.product_name %> (<%= item.sku %>)</span>
              <span>Rp <%= number_with_delimiter(item.price.to_i) %></span>
            </div>
          <% end %>
        </div>

        <div style="display: flex; gap: 8px; margin-top: 14px;">
          <%= link_to "🖨️ Print Label AWB", label_view_dashboard_path(card.id, merchant_id: @current_merchant&.id), 
                target: "_blank", 
                class: "btn-action", 
                style: "text-align: center; text-decoration: none;" %>
        </div>

      </div>
    <% end %>
  <% end %>
</div>