<% if flash[:notice].present? %>
  <div class="flash-banner flash-notice">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div class="flash-banner flash-alert">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<!-- Top Header Row -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
  <h1 style="font-size: 32px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0;">
    Order Queue Pipeline
  </h1>

  <div style="display: flex; gap: 12px; align-items: center;">
    <button type="button" class="btn-action" style="background: var(--surface-container-high); color: var(--on-surface); border: 1px solid var(--border-highlight); width: auto; padding: 10px 18px;" onclick="document.getElementById('filter-drawer').classList.add('active');">
      <span>⚡ Filter</span>
    </button>

    <button type="button" class="btn-action" style="background: var(--primary-neon); color: var(--on-primary); width: auto; padding: 10px 20px;" onclick="document.getElementById('manual-order-modal').classList.add('active');">
      <span>+ New Manual Order</span>
    </button>
  </div>

</div>

<!-- Stepper Pipeline Bar Connected -->
<div class="pipeline-stepper" style="margin-bottom: 32px;">
  <% 
    status_filter = params[:status_filter].to_s 
    all_cards = @order_cards || []
    count_all = all_cards.size
    count_received = all_cards.count { |c| c.status == 'received' }
    count_packing = all_cards.count { |c| c.status == 'packing' }
    count_packed = all_cards.count { |c| c.status == 'packed' }
    count_dispatched = all_cards.count { |c| c.status == 'dispatched' }

    filtered_cards = if status_filter.present?
      all_cards.select { |c| c.status == status_filter }
    else
      all_cards
    end
  %>

  <%= link_to orders_path(merchant_id: @current_merchant&.id), class: "step-pill #{'active' if status_filter.empty?}" do %>
    <span>All Orders (<%= count_all %>)</span>
  <% end %>

  <div style="color: var(--outline); font-weight: bold; align-self: center;">—</div>

  <%= link_to orders_path(merchant_id: @current_merchant&.id, status_filter: 'received'), class: "step-pill #{'active' if status_filter == 'received'}" do %>
    <span>1. Received (<%= count_received %>)</span>
  <% end %>

  <div style="color: var(--outline); font-weight: bold; align-self: center;">—</div>

  <%= link_to orders_path(merchant_id: @current_merchant&.id, status_filter: 'packing'), class: "step-pill #{'active' if status_filter == 'packing'}" do %>
    <span>2. Packing (<%= count_packing %>)</span>
  <% end %>

  <div style="color: var(--outline); font-weight: bold; align-self: center;">—</div>

  <%= link_to orders_path(merchant_id: @current_merchant&.id, status_filter: 'packed'), class: "step-pill #{'active' if status_filter == 'packed'}" do %>
    <span>3. Packed (<%= count_packed %>)</span>
  <% end %>

  <div style="color: var(--outline); font-weight: bold; align-self: center;">—</div>

  <%= link_to orders_path(merchant_id: @current_merchant&.id, status_filter: 'dispatched'), class: "step-pill #{'active' if status_filter == 'dispatched'}" do %>
    <span>4. Dispatched (<%= count_dispatched %>)</span>
  <% end %>
</div>

<!-- Order Cards Grid (3 Columns) -->
<div class="grid-container" id="order-queue-grid">
  <% if filtered_cards.empty? %>
    <div style="grid-column: 1 / -1; text-align: center; padding: 60px; color: var(--on-surface-variant); background: var(--surface-container); border-radius: 16px; border: 1px solid var(--border-highlight);">
      No active orders found in this pipeline stage.
    </div>
  <% else %>
    <% filtered_cards.each_with_index do |card, idx| %>
      <div class="order-card" id="order-card-<%= card.id %>">
        <div>
          <!-- Top Card Meta -->
          <div class="card-header">
            <div>
              <span class="order-num" style="font-size: 15px; font-weight: 700; color: #fff;">#<%= card.order_number %></span>
              <div style="font-size: 11px; color: var(--on-surface-variant); margin-top: 2px;">
                <%= card.created_at ? card.created_at.strftime("%a, %I:%M %p") : Time.current.strftime("%a, %I:%M %p") %>
              </div>
            </div>
            <div class="badges-row">
              <span class="urgency-badge urgency-<%= card.sla_urgency %>"><%= card.sla_urgency.tr('_', ' ') %></span>
              <span class="status-badge status-<%= card.status %>"><%= card.status.tr('_', ' ') %></span>
            </div>
          </div>

          <!-- Customer Buyer Details Box -->
          <div style="padding: 12px 0; border-top: 1px solid var(--border-highlight); border-bottom: 1px solid var(--border-highlight); margin-bottom: 12px;">
            <div style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="font-size: 16px;">👤</span>
              <div>
                <div style="font-size: 14px; font-weight: 700; color: #fff;"><%= card.buyer_name %></div>
                <div style="font-size: 12px; color: var(--on-surface-variant); margin-top: 2px;"><%= card.shipping_address %></div>
              </div>
            </div>
          </div>

          <!-- Product Manifest Box -->
          <div>
            <div style="font-size: 12px; font-weight: 700; color: var(--on-surface-variant); text-transform: uppercase; margin-bottom: 8px;">
              Manifest
            </div>

            <div class="item-list" style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); padding: 12px; border-radius: 8px;">
              <% card.items.each_with_index do |item, item_idx| %>
                <div style="margin-bottom: 6px;">
                  <div style="display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; color: #fff;">
                    <span><%= item.quantity %>x <%= item.product_name %></span>
                    <span class="tech-code" style="font-size: 11px; color: var(--on-surface-variant);">SKU: <%= item.sku %></span>
                  </div>

                  <div style="margin-top: 6px; font-size: 11px;">
                    <% if card.status == 'packed' %>
                      <span style="color: var(--secondary-emerald); font-weight: bold;">✓ Picked from <%= item.bin_location %></span>
                    <% elsif card.status == 'dispatched' || card.status == 'in_transit' %>
                      <span style="color: var(--tertiary-violet); font-weight: bold;">🚚 Tracking: <%= card.tracking_number.presence || "TRK-#{card.order_number}" %></span>
                    <% else %>
                      <span style="color: var(--secondary-emerald);">📍 <%= item.bin_location %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Card Bottom Action Buttons Row -->
        <div style="margin-top: 16px;">
          <% if card.status == 'received' || card.status == 'packing' %>
            <div style="display: flex; gap: 8px;">
              <%= link_to scanner_path(merchant_id: @current_merchant&.id, order_id: card.id), 
                    class: "btn-action", 
                    style: "flex: 1; background: linear-gradient(135deg, #8083ff, #6366f1); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; font-size: 13px;" do %>
                <span>📱 Scan Order</span>
              <% end %>

              <%= button_to update_status_dashboard_path(card.id, merchant_id: @current_merchant&.id, status: 'packed'), 
                    method: :patch, 
                    class: "btn-action btn-success", 
                    style: "width: 44px; padding: 10px; display: flex; align-items: center; justify-content: center; gap: 6px;", title: "Mark Packed" do %>
                <span>📦</span>
              <% end %>

              <%= link_to label_view_dashboard_path(card.id, merchant_id: @current_merchant&.id), 
                    target: "_blank", 
                    class: "btn-action", 
                    style: "width: 44px; padding: 10px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; display: flex; align-items: center; justify-content: center;", title: "Print Thermal AWB Label" do %>
                <span>🖨️</span>
              <% end %>
            </div>

          <% elsif card.status == 'packed' %>
            <div style="display: flex; gap: 8px;">
              <%= button_to dispatch_fleet_pulse_dashboard_path(card.id, merchant_id: @current_merchant&.id), 
                    method: :post, 
                    class: "btn-action btn-fleetpulse", 
                    style: "flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;" do %>
                <span>🛵 Request Pickup</span>
              <% end %>

              <%= link_to label_view_dashboard_path(card.id, merchant_id: @current_merchant&.id), 
                    target: "_blank", 
                    class: "btn-action", 
                    style: "width: 44px; padding: 10px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; display: flex; align-items: center; justify-content: center;" do %>
                <span>🖨️</span>
              <% end %>
            </div>
          <% else %>
            <div>
              <%= link_to fleet_radar_path(merchant_id: @current_merchant&.id), 
                    class: "btn-action", 
                    style: "background: transparent; border: 1px solid var(--border-highlight); color: #fff; display: flex; align-items: center; justify-content: center; gap: 6px;" do %>
                <span>👁️ Track Driver</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<!-- Modal Dialog for + New Manual Order -->
<div id="manual-order-modal" class="modal-overlay">
  <div class="modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 20px; font-weight: 700; color: #fff; font-family: 'Outfit';">✨ Create New Manual Order</h3>
      <span style="font-size: 20px; cursor: pointer; color: var(--on-surface-variant);" onclick="document.getElementById('manual-order-modal').classList.remove('active');">&times;</span>
    </div>

    <%= form_with url: manual_create_orders_path(merchant_id: @current_merchant&.id), method: :post, local: true do |f| %>
      <div style="margin-bottom: 12px;">
        <label style="font-size: 12px; color: var(--on-surface-variant); font-weight: 600; display: block; margin-bottom: 4px;">Buyer Full Name</label>
        <%= f.text_field :buyer_name, placeholder: "e.g. Sarah Jane", required: true, style: "width: 100%; background: var(--surface-container-low); border: 1px solid var(--border-highlight); padding: 10px; border-radius: 8px; color: #fff;" %>
      </div>

      <div style="margin-bottom: 12px;">
        <label style="font-size: 12px; color: var(--on-surface-variant); font-weight: 600; display: block; margin-bottom: 4px;">Phone Number</label>
        <%= f.text_field :buyer_phone, placeholder: "e.g. 0812-3456-7890", required: true, style: "width: 100%; background: var(--surface-container-low); border: 1px solid var(--border-highlight); padding: 10px; border-radius: 8px; color: #fff;" %>
      </div>

      <div style="margin-bottom: 12px;">
        <label style="font-size: 12px; color: var(--on-surface-variant); font-weight: 600; display: block; margin-bottom: 4px;">Shipping Address</label>
        <%= f.text_area :shipping_address, placeholder: "e.g. 124 Maple Street, Brooklyn, NY", required: true, rows: 2, style: "width: 100%; background: var(--surface-container-low); border: 1px solid var(--border-highlight); padding: 10px; border-radius: 8px; color: #fff;" %>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px;">
        <div>
          <label style="font-size: 12px; color: var(--on-surface-variant); font-weight: 600; display: block; margin-bottom: 4px;">Product Name</label>
          <%= f.text_field :product_name, placeholder: "e.g. Silk Hijab Premium", required: true, style: "width: 100%; background: var(--surface-container-low); border: 1px solid var(--border-highlight); padding: 10px; border-radius: 8px; color: #fff;" %>
        </div>

        <div>
          <label style="font-size: 12px; color: var(--on-surface-variant); font-weight: 600; display: block; margin-bottom: 4px;">SKU Code</label>
          <%= f.text_field :sku, placeholder: "e.g. BH-SLK-001", required: true, style: "width: 100%; background: var(--surface-container-low); border: 1px solid var(--border-highlight); padding: 10px; border-radius: 8px; color: #fff; font-family: monospace;" %>
        </div>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <button type="button" class="btn-action" style="background: transparent; border: 1px solid var(--border-highlight); color: var(--on-surface-variant); width: auto;" onclick="document.getElementById('manual-order-modal').classList.remove('active');">Cancel</button>
        <%= f.submit "Save & Queue Order", class: "btn-action btn-success", style: "width: auto; padding: 10px 24px;" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Slide-Over Drawer for Filter Order Queue (100% Matching Stitch AI screen.png) -->
<div id="filter-drawer" class="drawer-overlay">
  <div class="drawer-panel">
    <div>
      <!-- Drawer Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 20px;">⚡</span>
          <h2 style="font-size: 22px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0;">Filter Order Queue</h2>
        </div>
        <span style="font-size: 24px; cursor: pointer; color: var(--on-surface-variant);" onclick="document.getElementById('filter-drawer').classList.remove('active');">&times;</span>
      </div>


      <%= form_with url: orders_path, method: :get, local: true do |f| %>
        <%= f.hidden_field :merchant_id, value: @current_merchant&.id %>

        <!-- Section 1: Date Range -->
        <div style="margin-bottom: 24px;">
          <div class="filter-section-title">
            <span>Date Range</span>
          </div>

          <div class="filter-pill-group">
            <button type="button" class="filter-pill-opt active">Today</button>
            <button type="button" class="filter-pill-opt">Overdue</button>
            <button type="button" class="filter-pill-opt">📅 Custom Date</button>
          </div>
        </div>

        <!-- Section 2: SLA Urgency Multi-Select -->
        <div style="margin-bottom: 24px;">
          <div class="filter-section-title">
            <span>SLA Urgency</span>
            <span style="background: var(--surface-container-high); padding: 2px 6px; border-radius: 4px; font-size: 10px;">MULTI-SELECT</span>
          </div>

          <label class="filter-option-row">
            <div style="display: flex; align-items: center; gap: 10px;">
              <input type="checkbox" name="urgency[]" value="overdue" checked style="accent-color: var(--error-rose);">
              <span style="font-weight: 700; font-family: var(--font-tech); color: var(--error-rose);">OVERDUE</span>
            </div>
            <span style="font-family: var(--font-tech); color: var(--on-surface-variant); font-weight: 700;">12</span>
          </label>

          <label class="filter-option-row">
            <div style="display: flex; align-items: center; gap: 10px;">
              <input type="checkbox" name="urgency[]" value="due_soon" style="accent-color: var(--secondary-emerald);">
              <span style="font-weight: 700; font-family: var(--font-tech); color: var(--secondary-emerald);">DUE SOON</span>
            </div>
            <span style="font-family: var(--font-tech); color: var(--on-surface-variant); font-weight: 700;">45</span>
          </label>

          <label class="filter-option-row">
            <div style="display: flex; align-items: center; gap: 10px;">
              <input type="checkbox" name="urgency[]" value="due_today" style="accent-color: var(--primary-neon);">
              <span style="font-weight: 700; font-family: var(--font-tech); color: var(--primary-neon);">DUE TODAY</span>
            </div>
            <span style="font-family: var(--font-tech); color: var(--on-surface-variant); font-weight: 700;">128</span>
          </label>
        </div>

        <!-- Section 3: Order Status Grid -->
        <div style="margin-bottom: 24px;">
          <div class="filter-section-title">
            <span>Order Status</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <label class="filter-option-row" style="margin: 0;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="status_filter[]" value="received">
                <span style="font-size: 13px; color: var(--on-surface);">Received</span>
              </div>
            </label>

            <label class="filter-option-row" style="margin: 0;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="status_filter[]" value="packing" checked style="accent-color: var(--primary-neon);">
                <span style="font-size: 13px; color: var(--on-surface);">Packing</span>
              </div>
            </label>

            <label class="filter-option-row" style="margin: 0;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="status_filter[]" value="packed">
                <span style="font-size: 13px; color: var(--on-surface);">Packed</span>
              </div>
            </label>

            <label class="filter-option-row" style="margin: 0;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="status_filter[]" value="dispatched">
                <span style="font-size: 13px; color: var(--on-surface);">Dispatched</span>
              </div>
            </label>

            <label class="filter-option-row" style="margin: 0;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="status_filter[]" value="in_transit">
                <span style="font-size: 13px; color: var(--on-surface);">In Transit</span>
              </div>
            </label>

            <label class="filter-option-row" style="margin: 0;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="status_filter[]" value="delivered">
                <span style="font-size: 13px; color: var(--on-surface);">Delivered</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Section 4: Merchant Channel -->
        <div style="margin-bottom: 32px;">
          <div class="filter-section-title">
            <span>Merchant Channel</span>
          </div>

          <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 8px; padding: 10px;">
            <span style="font-size: 13px; color: var(--on-surface);"><%= @current_merchant ? @current_merchant.name : 'All Merchant Stores' %></span>
          </div>
        </div>

        <!-- Drawer Footer Action Buttons -->
        <div style="display: flex; gap: 12px; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid var(--border-highlight);">
          <%= link_to "Reset All", orders_path(merchant_id: @current_merchant&.id), class: "btn-action", style: "background: transparent; border: 1px solid var(--border-highlight); color: var(--on-surface-variant); width: auto; padding: 12px 20px;" %>
          <%= f.submit "Apply Filters →", class: "btn-apply-gradient", style: "flex: 1; justify-content: center;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>