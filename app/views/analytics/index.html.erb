<%= render "shared/navbar" %>
<%= render "shared/navigation_tabs" %>

<h2 style="margin-bottom: 20px; font-size: 22px; font-weight: 600;">📊 SLA Compliance & Logistics KPI Performance</h2>

<!-- KPI Executive Summary Row -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
  <div class="order-card" style="border-color: rgba(99, 102, 241, 0.4); text-align: center;">
    <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: bold; margin-bottom: 6px;">
      🎯 SLA ON-TIME RATE
    </div>
    <div style="font-size: 32px; font-weight: 800; color: #818cf8;">
      <%= @sla_compliance_rate %>%
    </div>
    <div style="font-size: 11px; color: #a7f3d0; margin-top: 4px;">
      Same-Day Cutoff Compliance Target: > 95%
    </div>
  </div>

  <div class="order-card" style="border-color: rgba(16, 185, 129, 0.4); text-align: center;">
    <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: bold; margin-bottom: 6px;">
      📦 TOTAL ACTIVE ORDERS
    </div>
    <div style="font-size: 32px; font-weight: 800; color: #34d399;">
      <%= @total_orders %>
    </div>
    <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
      Open Fulfillment Pipeline
    </div>
  </div>

  <div class="order-card" style="border-color: rgba(239, 68, 68, 0.4); text-align: center;">
    <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: bold; margin-bottom: 6px;">
      🚨 OVERDUE SLA VIOLATIONS
    </div>
    <div style="font-size: 32px; font-weight: 800; color: #f87171;">
      <%= @overdue_orders_count %>
    </div>
    <div style="font-size: 11px; color: #fecdd3; margin-top: 4px;">
      Requires Immediate Warehouse Dispatch
    </div>
  </div>

  <div class="order-card" style="border-color: rgba(245, 158, 11, 0.4); text-align: center;">
    <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: bold; margin-bottom: 6px;">
      💰 TOTAL MERCHANT REVENUE
    </div>
    <div style="font-size: 26px; font-weight: 800; color: #fbbf24;">
      Rp <%= number_with_delimiter(@total_revenue.to_i) %>
    </div>
    <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
      Processed Pipeline GMV
    </div>
  </div>
</div>

<!-- Top Selling Fashion Products Ranking -->
<h3 style="margin-bottom: 16px; font-size: 18px; font-weight: 600;">🏆 Top Selling Fashion Products Ranking</h3>

<div class="order-card">
  <% if (@top_products || []).empty? %>
    <div style="text-align: center; padding: 20px; color: var(--text-muted);">
      No sales data recorded yet.
    </div>
  <% else %>
    <table class="manifest-table" style="width: 100%; border-collapse: collapse; color: var(--text-main);">
      <thead>
        <tr style="border-bottom: 2px solid var(--border-color); text-align: left; font-size: 13px; color: var(--text-muted);">
          <th style="padding: 10px;">Rank</th>
          <th style="padding: 10px;">SKU</th>
          <th style="padding: 10px;">Product Name</th>
          <th style="padding: 10px; text-align: center;">Units Sold</th>
          <th style="padding: 10px; text-align: right;">Revenue (GMV)</th>
        </tr>
      </thead>
      <tbody>
        <% (@top_products || []).each_with_index do |prod, idx| %>
          <tr style="border-bottom: 1px solid var(--border-color); font-size: 13px;">
            <td style="padding: 12px; font-weight: bold; color: #fbbf24;">#<%= idx + 1 %></td>
            <td style="padding: 12px; font-family: monospace;"><%= prod.sku %></td>
            <td style="padding: 12px; font-weight: 600;"><%= prod.product_name %></td>
            <td style="padding: 12px; text-align: center; font-weight: bold; color: #34d399;"><%= prod.total_units_sold %> pcs</td>
            <td style="padding: 12px; text-align: right; font-weight: bold; color: #818cf8;">Rp <%= number_with_delimiter(prod.total_revenue.to_i) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
