<%= render "shared/navbar" %>
<%= render "shared/navigation_tabs" %>

<h2 style="margin-bottom: 20px; font-size: 22px; font-weight: 600;">🏭 Warehouse Inventory & Bin Location Mapping</h2>

<div class="grid-container">
  <% if (@inventory_list || []).empty? %>
    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-muted);">
      No inventory products mapped for this merchant.
    </div>
  <% else %>
    <% (@inventory_list || []).each do |inv| %>
      <div class="order-card" style="border-color: rgba(16, 185, 129, 0.4);">
        <div>
          <div class="card-header">
            <span class="order-num">🏷️ <%= inv.sku %></span>
            <% if inv.low_stock_warning %>
              <span class="urgency-badge urgency-overdue">🔴 Low Stock Alert</span>
            <% else %>
              <span class="status-badge status-delivered">🟢 Healthy Stock</span>
            <% end %>
          </div>

          <div style="font-size: 15px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">
            <%= inv.product_name %>
          </div>

          <div style="margin-bottom: 12px;">
            <span class="bin-badge" style="font-size: 12px; padding: 4px 10px;">📍 Physical Location: <strong><%= inv.bin_location %></strong></span>
          </div>

          <!-- Stock Levels Stats Box -->
          <div class="item-list" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(16, 185, 129, 0.3);">
            <div class="item-row">
              <span>🏭 Physical Warehouse Stock</span>
              <span style="font-weight: bold; color: #f8fafc;"><%= inv.physical_stock %> pcs</span>
            </div>
            <div class="item-row">
              <span>🔒 Allocated (Active Orders)</span>
              <span style="font-weight: bold; color: #fbbf24;"><%= inv.allocated_stock %> pcs</span>
            </div>
            <div class="item-row">
              <span>✅ Available to Sell</span>
              <span style="font-weight: bold; color: #34d399; font-size: 14px;"><%= inv.available_stock %> pcs</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
