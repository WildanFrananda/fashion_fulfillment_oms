<% if flash[:notice].present? %>
  <div class="flash-banner flash-notice">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div class="flash-banner flash-alert">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<!-- Main Header Row -->
<div style="margin-bottom: 32px;">
  <h1 style="font-size: 32px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
    Warehouse Operations & Integration Help Center
  </h1>
  <p style="font-size: 14px; color: var(--on-surface-variant); margin: 0; max-width: 900px;">
    Access critical standard operating procedures, technical documentation, and real-time system diagnostics to maintain operational velocity.
  </p>
</div>

<!-- Section 1: CRITICAL RESOURCES (3 Columns Grid) -->
<div style="margin-bottom: 36px;">
  <div class="filter-section-title" style="margin-bottom: 16px;">
    <span>⬍ CRITICAL RESOURCES</span>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">

    <!-- Card 1: Warehouse SLA SOP Guide -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.2s ease, border-color 0.2s ease;" onclick="alert('📖 Opening Warehouse SLA SOP Guide (SOP-LOG-2026-v3)');">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <div style="width: 42px; height: 42px; border-radius: 10px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); display: flex; align-items: center; justify-content: center; font-size: 20px;">
            📖
          </div>
          <span style="font-size: 18px; color: var(--on-surface-variant);">→</span>
        </div>

        <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
          Warehouse SLA SOP Guide
        </h3>
        <p style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.5; margin: 0;">
          Standard operating procedures for maintaining Service Level Agreement compliance during peak fulfillment shifts.
        </p>
      </div>
    </div>

    <!-- Card 2: FleetPulse Elixir API Docs -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.2s ease, border-color 0.2s ease;" onclick="alert('💠 Opening FleetPulse Elixir API Documentation v2.4');">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <div style="width: 42px; height: 42px; border-radius: 10px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); display: flex; align-items: center; justify-content: center; font-size: 20px;">
            💠
          </div>
          <span style="font-size: 18px; color: var(--on-surface-variant);">→</span>
        </div>

        <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
          FleetPulse Elixir API Docs
        </h3>
        <p style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.5; margin: 0;">
          Technical documentation for integrating with the FleetPulse WebSocket cluster and automated driver dispatch API.
        </p>
      </div>
    </div>

    <!-- Card 3: Emergency Protocol SOP -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.2s ease, border-color 0.2s ease;" onclick="alert('⚠️ Opening Emergency Protocol SOP (Disaster Recovery Triage)');">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(255, 180, 171, 0.1); border: 1px solid var(--error-container); display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--error-rose);">
            ⚠️
          </div>
          <span style="font-size: 18px; color: var(--on-surface-variant);">→</span>
        </div>

        <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
          Emergency Protocol SOP
        </h3>
        <p style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.5; margin: 0;">
          Immediate action workflows for system outages, critical hardware failures, and manual override procedures.
        </p>
      </div>
    </div>

  </div>
</div>

<!-- Section 2: LIVE SYSTEM HEALTH & HUMAN INTERVENTION (2 Columns) -->
<div style="display: grid; grid-template-columns: 380px 1fr; gap: 24px;">

  <!-- Left Card: LIVE SYSTEM HEALTH -->
  <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px;">
    <div class="filter-section-title" style="margin-bottom: 20px;">
      <span>🗄️ LIVE SYSTEM HEALTH</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 10px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 16px; color: var(--primary-neon);">~</span>
          <span style="font-size: 13px; font-weight: 600; color: #fff;">Action Cable</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <span style="font-size: 12px; font-weight: 700; color: var(--secondary-emerald);">Connected</span>
          <div class="pulse-dot"></div>
        </div>
      </div>

      <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 10px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 16px; color: var(--tertiary-violet);">⌁</span>
          <span style="font-size: 13px; font-weight: 600; color: #fff;">Phoenix WebSocket</span>
        </div>
        <div style="font-family: var(--font-tech); font-size: 12px; font-weight: 700; color: var(--on-surface-variant);">
          12ms Ping
        </div>
      </div>

      <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 10px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 16px;">🗄️</span>
          <span style="font-size: 13px; font-weight: 600; color: #fff;">PostgreSQL DB</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--secondary-emerald);">
          <span>Healthy</span> <span>✓</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Card: Need Human Intervention? -->
  <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <h2 style="font-size: 24px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 10px 0;">
        Need Human Intervention?
      </h2>
      <p style="font-size: 14px; color: var(--on-surface-variant); line-height: 1.6; margin: 0; max-width: 600px;">
        Escalate complex logistics anomalies or technical faults directly to the Level 3 Command Center.
      </p>
    </div>

    <div style="display: flex; gap: 16px; margin-top: 24px; flex-wrap: wrap;">
      <%= button_to create_ticket_support_path(merchant_id: @current_merchant&.id), method: :post, class: "btn-action", style: "background: var(--primary-neon); color: var(--on-primary); width: auto; padding: 14px 28px; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 8px;" do %>
        <span>🎫 Open Support Ticket</span>
      <% end %>

      <%= button_to start_chat_support_path(merchant_id: @current_merchant&.id), method: :post, class: "btn-action", style: "background: transparent; border: 1px solid var(--secondary-emerald); color: var(--secondary-emerald); width: auto; padding: 14px 28px; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 8px;" do %>
        <span>💬 Start Live Chat</span>
      <% end %>
    </div>
  </div>

</div>
