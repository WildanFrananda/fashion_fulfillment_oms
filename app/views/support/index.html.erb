<% if flash[:notice].present? %>
  <div class="flash-banner flash-notice">
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div class="flash-banner flash-alert">
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<!-- Main Header Row -->
<div style="margin-bottom: 32px;">
  <h1 style="font-size: 32px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
    Warehouse Operations & Integration Help Center
  </h1>
  <p style="font-size: 14px; color: var(--on-surface-variant); margin: 0; max-width: 900px;">
    Access critical standard operating procedures, technical documentation, and real-time system diagnostics to maintain operational velocity for <strong style="color: #fff;"><%= @current_merchant&.name %></strong>.
  </p>
</div>

<!-- Section 1: CRITICAL RESOURCES (3 Columns Grid) -->
<div style="margin-bottom: 36px;">
  <div class="filter-section-title" style="margin-bottom: 16px;">
    <span>⬍ CRITICAL RESOURCES</span>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">

    <!-- Card 1: Warehouse SLA SOP Guide -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.2s ease, border-color 0.2s ease;" onclick="document.getElementById('sop-modal').classList.add('active');">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <div style="width: 42px; height: 42px; border-radius: 10px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); display: flex; align-items: center; justify-content: center; font-size: 20px;">
            📖
          </div>
          <span style="font-size: 18px; color: var(--on-surface-variant);">→</span>
        </div>

        <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
          Warehouse SLA SOP Guide
        </h3>
        <p style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.5; margin: 0;">
          Standard operating procedures for maintaining Service Level Agreement compliance during peak fulfillment shifts.
        </p>
      </div>
    </div>

    <!-- Card 2: FleetPulse Elixir API Docs -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.2s ease, border-color 0.2s ease;" onclick="document.getElementById('api-modal').classList.add('active');">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <div style="width: 42px; height: 42px; border-radius: 10px; background: var(--surface-container-high); border: 1px solid var(--border-highlight); display: flex; align-items: center; justify-content: center; font-size: 20px;">
            💠
          </div>
          <span style="font-size: 18px; color: var(--on-surface-variant);">→</span>
        </div>

        <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
          FleetPulse Elixir API Docs
        </h3>
        <p style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.5; margin: 0;">
          Technical documentation for integrating with the FleetPulse WebSocket cluster and automated driver dispatch API.
        </p>
      </div>
    </div>

    <!-- Card 3: Emergency Protocol SOP -->
    <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.2s ease, border-color 0.2s ease;" onclick="document.getElementById('emergency-modal').classList.add('active');">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(255, 180, 171, 0.1); border: 1px solid var(--error-container); display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--error-rose);">
            ⚠️
          </div>
          <span style="font-size: 18px; color: var(--on-surface-variant);">→</span>
        </div>

        <h3 style="font-size: 18px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 8px 0;">
          Emergency Protocol SOP
        </h3>
        <p style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.5; margin: 0;">
          Immediate action workflows for system outages, critical hardware failures, and manual override procedures.
        </p>
      </div>
    </div>

  </div>
</div>

<!-- Section 2: LIVE SYSTEM HEALTH & HUMAN INTERVENTION (2 Columns) -->
<div style="display: grid; grid-template-columns: 380px 1fr; gap: 24px;">

  <!-- Left Card: LIVE SYSTEM HEALTH -->
  <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 24px;">
    <div class="filter-section-title" style="margin-bottom: 20px;">
      <span>🗄️ LIVE SYSTEM HEALTH</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 10px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 16px; color: var(--primary-neon);">~</span>
          <span style="font-size: 13px; font-weight: 600; color: #fff;">Action Cable</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <span style="font-size: 12px; font-weight: 700; color: <%= @action_cable_healthy ? 'var(--secondary-emerald)' : 'var(--error-rose)' %>;"><%= @action_cable_healthy ? 'Connected' : 'Disconnected' %></span>
          <% if @action_cable_healthy %><div class="pulse-dot"></div><% end %>
        </div>
      </div>

      <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 10px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 16px; color: var(--tertiary-violet);">⌁</span>
          <span style="font-size: 13px; font-weight: 600; color: #fff;">Phoenix WebSocket</span>
        </div>
        <div style="font-family: var(--font-tech); font-size: 12px; font-weight: 700; color: <%= @phoenix_healthy ? 'var(--secondary-emerald)' : 'var(--error-rose)' %>;">
          <% if @phoenix_healthy %>
            <span><%= @phoenix_ping_ms %>ms Ping</span>
          <% else %>
            <span>Offline ✖</span>
          <% end %>
        </div>
      </div>


      <div style="background: var(--surface-container-low); border: 1px solid var(--border-highlight); border-radius: 10px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 16px;">🗄️</span>
          <span style="font-size: 13px; font-weight: 600; color: #fff;">PostgreSQL DB</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: <%= @db_healthy ? 'var(--secondary-emerald)' : 'var(--error-rose)' %>;">
          <span><%= @db_healthy ? 'Healthy' : 'Offline' %></span> <span><%= @db_healthy ? '✓' : '✖' %></span>
        </div>
      </div>
    </div>

  </div>

  <!-- Right Card: Need Human Intervention? -->
  <div style="background: var(--surface-container); border: 1px solid var(--border-highlight); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <h2 style="font-size: 24px; font-weight: 700; color: #fff; font-family: 'Outfit'; margin: 0 0 10px 0;">
        Need Human Intervention?
      </h2>
      <p style="font-size: 14px; color: var(--on-surface-variant); line-height: 1.6; margin: 0; max-width: 600px;">
        Escalate complex logistics anomalies or technical faults directly to the Level 3 Command Center for <strong style="color: #fff;"><%= @current_merchant&.name %></strong>.
      </p>
    </div>

    <div style="display: flex; gap: 16px; margin-top: 24px; flex-wrap: wrap;">
      <button type="button" class="btn-action" style="background: var(--primary-neon); color: var(--on-primary); width: auto; padding: 14px 28px; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 8px;" onclick="document.getElementById('ticket-modal').classList.add('active');">
        <span>🎫 Open Support Ticket</span>
      </button>

      <%= button_to start_chat_support_path(merchant_id: @current_merchant&.id), method: :post, class: "btn-action", style: "background: transparent; border: 1px solid var(--secondary-emerald); color: var(--secondary-emerald); width: auto; padding: 14px 28px; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 8px;" do %>
        <span>💬 Start Live Chat</span>
      <% end %>
    </div>
  </div>

</div>

<!-- Modal 1: Warehouse SLA SOP Guide -->
<div id="sop-modal" class="modal-overlay">
  <div class="modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 20px; font-weight: 700; color: #fff; font-family: 'Outfit';">📖 Warehouse SLA SOP Guide</h3>
      <span style="font-size: 20px; cursor: pointer; color: var(--on-surface-variant);" onclick="document.getElementById('sop-modal').classList.remove('active');">&times;</span>
    </div>
    <div style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.6;">
      <p><strong style="color: #fff;">1. Cutoff Triage:</strong> Orders received before <%= sprintf('%02d', @current_merchant&.cutoff_hour || 14) %>:00 WIB must be picked & packed within 60 minutes.</p>
      <p><strong style="color: #fff;">2. Barcode Scanning:</strong> Every item SKU & resi barcode must be scanned via JsBarcode thermal label before handing over to courier.</p>
    </div>
    <div style="margin-top: 20px; text-align: right;">
      <button type="button" class="btn-action" style="background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; width: auto;" onclick="document.getElementById('sop-modal').classList.remove('active');">Close Guide</button>
    </div>
  </div>
</div>

<!-- Modal 2: FleetPulse Elixir API Docs -->
<div id="api-modal" class="modal-overlay">
  <div class="modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 20px; font-weight: 700; color: #fff; font-family: 'Outfit';">💠 FleetPulse Elixir API Docs</h3>
      <span style="font-size: 20px; cursor: pointer; color: var(--on-surface-variant);" onclick="document.getElementById('api-modal').classList.remove('active');">&times;</span>
    </div>
    <div style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.6;">
      <p><strong style="color: #fff;">Endpoint:</strong> <code style="color: var(--primary-neon);"><%= request.base_url %>/api/v1/orders</code></p>
      <p><strong style="color: #fff;">Auth Header:</strong> <code style="color: var(--primary-neon);">X-Merchant-Api-Key: <%= @current_merchant&.api_key %></code></p>
    </div>
    <div style="margin-top: 20px; text-align: right;">
      <button type="button" class="btn-action" style="background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; width: auto;" onclick="document.getElementById('api-modal').classList.remove('active');">Close Docs</button>
    </div>
  </div>
</div>

<!-- Modal 3: Emergency Protocol SOP -->
<div id="emergency-modal" class="modal-overlay">
  <div class="modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 20px; font-weight: 700; color: var(--error-rose); font-family: 'Outfit';">⚠️ Emergency Protocol SOP</h3>
      <span style="font-size: 20px; cursor: pointer; color: var(--on-surface-variant);" onclick="document.getElementById('emergency-modal').classList.remove('active');">&times;</span>
    </div>
    <div style="font-size: 13px; color: var(--on-surface-variant); line-height: 1.6;">
      <p><strong style="color: #fff;">1. Emergency Halt:</strong> Click 'Emergency Halt' in left sidebar to pause automated driver assignments.</p>
      <p><strong style="color: #fff;">2. Manual Escalation:</strong> Contact Level 3 Command Center via Live Chat.</p>
    </div>
    <div style="margin-top: 20px; text-align: right;">
      <button type="button" class="btn-action" style="background: var(--surface-container-high); border: 1px solid var(--border-highlight); color: #fff; width: auto;" onclick="document.getElementById('emergency-modal').classList.remove('active');">Close Protocol</button>
    </div>
  </div>
</div>

<!-- Modal 4: Open Support Ticket Form -->
<div id="ticket-modal" class="modal-overlay">
  <div class="modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 20px; font-weight: 700; color: #fff; font-family: 'Outfit';">🎫 Escalate Support Ticket</h3>
      <span style="font-size: 20px; cursor: pointer; color: var(--on-surface-variant);" onclick="document.getElementById('ticket-modal').classList.remove('active');">&times;</span>
    </div>

    <%= form_with url: create_ticket_support_path(merchant_id: @current_merchant&.id), method: :post, local: true do |f| %>
      <div style="margin-bottom: 16px;">
        <label style="font-size: 12px; color: var(--on-surface-variant); font-weight: 600; display: block; margin-bottom: 4px;">Ticket Subject / Anomaly Title</label>
        <%= f.text_field :subject, placeholder: "e.g. Courier Dispatch Delay / Picking Discrepancy", required: true, style: "width: 100%; background: var(--surface-container-low); border: 1px solid var(--border-highlight); padding: 10px; border-radius: 8px; color: #fff;" %>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <button type="button" class="btn-action" style="background: transparent; border: 1px solid var(--border-highlight); color: var(--on-surface-variant); width: auto;" onclick="document.getElementById('ticket-modal').classList.remove('active');">Cancel</button>
        <%= f.submit "Submit Ticket Escalation", class: "btn-action btn-success", style: "width: auto; padding: 10px 24px;" %>
      </div>
    <% end %>
  </div>
</div>
