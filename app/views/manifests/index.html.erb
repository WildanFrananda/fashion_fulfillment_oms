<%= render "shared/navbar" %>
<%= render "shared/navigation_tabs" %>

<h2 style="margin-bottom: 20px; font-size: 22px; font-weight: 600;">📄 Courier Handover Manifests & Batch Dispatch</h2>

<!-- Action Card Header -->
<div class="order-card" style="margin-bottom: 24px; border-color: rgba(99, 102, 241, 0.4);">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 4px; color: #fff;">🚚 FleetPulse Courier Handover Manifest</h3>
      <p style="font-size: 13px; color: var(--text-muted);">
        Export printable A4 official handover manifest (Surat Jalan Serah Terima Paket) for driver signature & barcode verification.
      </p>
    </div>
    <div>
      <%= link_to "📄 Print Official Handover Manifest (Surat Jalan PDF)", handover_pdf_manifests_path(merchant_id: @current_merchant&.id), 
            target: "_blank", 
            class: "btn-action btn-fleetpulse", 
            style: "padding: 12px 20px; font-size: 14px; text-decoration: none;" %>
    </div>
  </div>
</div>

<!-- Manifest Orders Table -->
<div class="order-card">
  <% if (@dispatched_orders || []).empty? %>
    <div style="text-align: center; padding: 40px; color: var(--text-muted);">
      No packages ready for handover manifest.
    </div>
  <% else %>
    <table style="width: 100%; border-collapse: collapse; color: var(--text-main);">
      <thead>
        <tr style="border-bottom: 2px solid var(--border-color); text-align: left; font-size: 13px; color: var(--text-muted);">
          <th style="padding: 12px;">Order #</th>
          <th style="padding: 12px;">Buyer Name</th>
          <th style="padding: 12px;">Shipping Address</th>
          <th style="padding: 12px;">Items Qty</th>
          <th style="padding: 12px;">Pipeline Status</th>
          <th style="padding: 12px; text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% (@dispatched_orders || []).each do |ord| %>
          <tr style="border-bottom: 1px solid var(--border-color); font-size: 13px;">
            <td style="padding: 12px; font-weight: bold; color: #818cf8;">#<%= ord.order_number %></td>
            <td style="padding: 12px; font-weight: 600;"><%= ord.buyer_name %></td>
            <td style="padding: 12px; color: var(--text-muted);"><%= ord.shipping_address %></td>
            <td style="padding: 12px;"><%= ord.order_items.sum(:quantity) %> pcs</td>
            <td style="padding: 12px;">
              <span class="status-badge status-<%= ord.status %>"><%= ord.status.tr('_', ' ') %></span>
            </td>
            <td style="padding: 12px; text-align: right;">
              <%= link_to "🖨️ Thermal Resi", label_view_dashboard_path(ord.id, merchant_id: @current_merchant&.id), 
                    target: "_blank", 
                    style: "color: #34d399; text-decoration: none; font-weight: 600;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
